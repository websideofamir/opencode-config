# GitHub PAT with `repo` and `admin:org` scopes (classic token)
# Generate at: https://github.com/settings/tokens
GITHUB_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub organization name to register runners against (org-level scope)
ORG_NAME=YOUR_ORG

# API token used by opencode.json via {env:CLIPROXY_API_KEY}
CLIPROXY_API_KEY=your_cliproxy_api_key_here
CLIPROXY_URL=our_cliproxy_api_url_here

CONTEXT7_API_KEY=your_context7_api_key_here