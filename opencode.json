{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "autoupdate": true,
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_ACCESS_TOKEN}"
      },
      "url": "https://api.githubcopilot.com/mcp"
    }
  },
  "tools": {
    "github_*": false,
    "github_add_issue_comment": true,
    "github_issue_write": true,
    "github_issue_read": true
  },
  "small_model": "cliproxy/vertex-gemini-3-flash-preview",
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "id": "cliproxy",
      "options": {
        "baseURL": "{env:CLIPROXY_URL}",
        "apiKey": "{env:CLIPROXY_API_KEY}"
      },
      "models": {
        "vertex-gemini-2.5-flash": {
          "name": "gemini 2.5 flash (Vertex)",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "vertex-deepseek-chat": {
          "name": "deepseek chat (Vertex)",
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "vertex-deepseek-reasoner": {
          "name": "deepseek reasoner (Vertex)",
          "limit": {
            "context": 128000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "vertex-gemini-2.5-pro": {
